{
  "name": "topimageprompt-oss",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source AI image prompt library and publishing platform.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/RipperHunter/topimageprompt-oss.git"
  },
  "homepage": "https://topimageprompt.com",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postinstall": "npx prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node scripts/ensure-sqlite.js && prisma db push",
    "db:seed": "prisma db seed",
    "check": "npm run lint && npm run build"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "marked": "^18.0.5",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "prisma": "^6.19.3",
    "react": "19.2.7",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4"
  },
  "overrides": {
    "cookie": "0.7.2",
    "next": {
      "postcss": "8.5.19"
    },
    "next-auth": {
      "uuid": "11.1.1"
    },
    "nodemailer": "9.0.3"
  }
}
