# Local SQLite database. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Public brand and canonical URL settings
NEXT_PUBLIC_BRAND_NAME="PromptVault"
NEXT_PUBLIC_BRAND_DOMAIN="localhost"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_HANDLE="promptvault"

# OAuth providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Transactional email. The default endpoint accepts the Resend email API shape.
EMAIL_API_URL="https://api.resend.com/emails"
EMAIL_API_KEY=""
EMAIL_FROM="PromptVault <no-reply@your-domain.example>"

# Seed-only admin credentials. Do not use weak defaults.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Emergency-only legacy SQLite schema bootstrap. Leave disabled for normal deploys.
ALLOW_RUNTIME_SCHEMA_SYNC=0
ALLOW_ORPHAN_PROCESS_CLEANUP=0

# Optional Cloudflare R2 / AWS S3 storage configurations.
# If configured, uploads will go to cloud bucket. If not, uploads fall back to public/uploads disk directory.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Optional absolute path for persistent local uploads when R2 is not configured.
LOCAL_UPLOADS_DIR=""

# Optional webhook guard
PINTEREST_WEBHOOK_SECRET=""

# Optional thread and process limits for resource-constrained hosting
TOKIO_WORKER_THREADS=1
UV_THREADPOOL_SIZE=1
